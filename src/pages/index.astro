---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products,categories} from '../data/products'; const featured=products.slice(0,6); const trending=products.slice(6,12); const base=import.meta.env.BASE_URL;
---
<BaseLayout><section class="hero"><div><div class="eyebrow">Z5 Global Beauty Marketplace</div><h1>Find what fits your routine.</h1><p>Discover real beauty and personal-care products, compare options, then continue to the merchant.</p><div class="buttons"><a class="btn" href={base+'search'}>Explore products</a><a class="btn light" href={base+'compare'}>Compare picks</a></div></div><div class="hero-art"><img src="https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?auto=format&fit=crop&w=1000&q=85" alt="Beauty products"><div class="hero-note"><b>Discovery first.</b><span>Z5 does not process payments. Prices and availability are verified before publication.</span></div></div></section><section class="section"><div class="head"><div><div class="eyebrow">Browse</div><h2>Shop by category</h2></div></div><div class="chips">{categories.map(c=><a class="chip" href={base+'search?category='+encodeURIComponent(c)}>{c}</a>)}</div></section><section class="section"><div class="head"><div><div class="eyebrow">Catalog</div><h2>Featured products</h2></div><a href={base+'search'}>View all →</a></div><div class="grid">{featured.map(p=><a class="card" href={base+'product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name}></div><div class="card-info"><div class="brand">{p.brand} · {p.category}</div><h3>{p.name}</h3><div class="meta"><span>{p.rating ? '★ '+p.rating : 'Rating pending'}</span><span class="price">{p.price ? '$ '+p.price : 'See merchant'}</span></div></div></a>)}</div></section><section class="section"><div class="head"><div><div class="eyebrow">Trending</div><h2>Worth a closer look</h2></div></div><div class="grid">{trending.map(p=><a class="card" href={base+'product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name}></div><div class="card-info"><div class="brand">{p.brand} · {p.category}</div><h3>{p.name}</h3><div class="meta"><span>{p.rating ? '★ '+p.rating : 'Rating pending'}</span><span class="price">{p.price ? '$ '+p.price : 'See merchant'}</span></div></div></a>)}</div></section><div class="trust"><div><b>Affiliate transparency.</b><p>Affiliate links stay disabled until a Z5 program relationship and tracking URL are verified.</p></div><a class="btn light" href={base+'disclosure'}>Read disclosure</a></div></BaseLayout>