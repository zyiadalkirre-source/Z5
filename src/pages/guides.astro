---
import BaseLayout from '../layouts/BaseLayout.astro'; const guides=[['How to compare skincare products','Compare product identity, ingredients when available, size, current price, rating source and merchant.'],['Hair-care shopping guide','Compare masks, conditioners, oils and styling products while separating product facts from editorial opinion.'],['Fragrance guide','Compare concentration, scent family, size and current merchant offer before shopping.'],['Men’s grooming guide','Compare shaving, skincare and grooming tools using the same transparent criteria.']]; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Beauty Guides — Z5"><section class="catalog"><div class="eyebrow">Guides</div><h1>Beauty shopping guides.</h1><p class="muted">Editorial content stays separate from merchant offers and affiliate tracking.</p></section><section class="section"><div class="grid">{guides.map(([title,desc])=><article class="card"><div class="card-info"><div class="brand">Z5 Editorial</div><h3>{title}</h3><p class="muted">{desc}</p><a class="btn light" href={base+'search'}>Explore products</a></div></article>)}</div></section></BaseLayout>