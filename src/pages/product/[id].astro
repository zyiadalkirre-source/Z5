---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {products} from '../../data/products'; export function getStaticPaths(){return products.map(p=>({params:{id:p.id},props:{product:p}}));} const {product}=Astro.props;
---
<BaseLayout title={product.name+' — Z5'} description={product.description}><section class="detail"><div class="detail-image"><img src={product.image} alt={product.name}></div><div><div class="eyebrow">{product.category} · {product.audience}</div><h1>{product.name}</h1><div>★ {product.rating} · {product.reviews} reviews</div><p class="desc">{product.description}</p><div class="price" style="font-size:26px">$ {product.price} <span class="muted" style="font-size:13px">· {product.size}</span></div><div class="offer"><div><b>Merchant offer</b><div class="muted">Price and availability may change.</div></div><a class="btn" href="#" data-shop data-product={product.id}>Shop Now ↗</a></div><div class="notice" style="margin-top:16px">Z5 may earn a commission from eligible shopping links. Z5 does not process payments or orders.</div></div></section></BaseLayout><script is:inline>document.querySelectorAll('[data-shop]').forEach(a=>a.addEventListener('click',()=>{const k='z5-clicks';const rows=JSON.parse(localStorage.getItem(k)||'[]');rows.push({product:a.dataset.product,timestamp:new Date().toISOString(),source:location.pathname});localStorage.setItem(k,JSON.stringify(rows));}));</script>