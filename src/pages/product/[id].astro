---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {products} from '../../data/products'; export function getStaticPaths(){return products.map(product=>({params:{id:product.id},props:{product}}));} const {product}=Astro.props; const base=import.meta.env.BASE_URL; const related=products.filter(p=>p.category===product.category&&p.id!==product.id).slice(0,3);
---
<BaseLayout title={product.name+' — Z5'} description={product.description}><section class="detail"><div><div class="detail-image"><img id="main-image" src={product.image} alt={product.name}></div><div class="gallery">{product.gallery.map((image,i)=><button type="button" class={i===0?'active':''} data-image={image}><img src={image} alt={product.name+' view '+(i+1)}></button>)}</div></div><div><div class="eyebrow">{product.category} · {product.audience}</div><h1>{product.name}</h1><div>{product.rating ? '★ '+product.rating+' · '+product.reviews+' reviews' : 'Rating pending verification'}</div><p class="desc">{product.description}</p><div class="price big">{product.price ? product.currency+' '+product.price : 'Price pending verification'} <span class="muted small">· {product.size}</span></div><ul class="feature-list">{product.features.map(f=><li>{f}</li>)}</ul>{product.ingredients&&<div class="notice"><b>Ingredients</b><p>{product.ingredients}</p></div>}<div class="offer"><div><b>{product.merchant}</b><div class="muted">{product.availability} · Updated {product.updatedAt}</div></div><a class="btn" href={product.affiliateStatus==='verified'&&product.affiliateUrl?product.affiliateUrl:product.merchantUrl} target="_blank" rel="noopener noreferrer sponsored" data-shop data-product={product.id}>Visit merchant ↗</a></div><div class="detail-actions"><button class="btn light" data-wish={product.id}>♡ Wishlist</button><button class="btn light" data-compare={product.id}>＋ Compare</button></div><div class="notice" style="margin-top:16px"><b>Trust & freshness</b><p>Price: {product.verifiedPrice?'verified':'pending'} · Rating source: {product.ratingSource||'pending'} · Rating date: {product.ratingDate||'pending'} · Affiliate: {product.affiliateStatus}.</p></div></div></section><section class="section"><div class="head"><div><div class="eyebrow">More like this</div><h2>Related products</h2></div></div><div class="grid">{related.map(p=><a class="card" href={base+'product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name}></div><div class="card-info"><div class="brand">{p.brand}</div><h3>{p.name}</h3><div class="meta"><span>{p.category}</span><span class="price">{p.price?'$ '+p.price:'Pending'}</span></div></div></a>)}</div></section><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Product","name":product.name,"brand":{"@type":"Brand","name":product.brand},"category":product.category,"image":product.gallery,"description":product.description,"offers":product.price?{"@type":"Offer","price":product.price,"priceCurrency":product.currency}:undefined})}></BaseLayout>
<script is:inline>const id='${product.id}';const base='${base}';const read=k=>JSON.parse(localStorage.getItem(k)||'[]');const recent=read('z5-recent').filter(x=>x!==id);localStorage.setItem('z5-recent',JSON.stringify([id,...recent].slice(0,12)));document.querySelectorAll('[data-image]').forEach(b=>b.addEventListener('click',()=>{document.querySelector('#main-image').src=b.dataset.image;document.querySelectorAll('[data-image]').forEach(x=>x.classList.remove('active'));b.classList.add('active')}));document.querySelector('[data-wish]')?.addEventListener('click',()=>{const a=read('z5-wishlist');const next=a.includes(id)?a.filter(x=>x!==id):[...a,id];localStorage.setItem('z5-wishlist',JSON.stringify(next));location.reload()});document.querySelector('[data-compare]')?.addEventListener('click',()=>{const a=read('z5-compare');if(!a.includes(id)&&a.length<4)a.push(id);localStorage.setItem('z5-compare',JSON.stringify(a));location.href=base+'compare'});document.querySelector('[data-shop]')?.addEventListener('click',()=>{const rows=read('z5-clicks');rows.push({product:id,timestamp:new Date().toISOString(),source:location.pathname,merchant:'${product.merchant}',url:'${product.affiliateStatus==='verified'&&product.affiliateUrl?product.affiliateUrl:product.merchantUrl}',context:'product-page',campaign:new URLSearchParams(location.search).get('utm_campaign')||''});localStorage.setItem('z5-clicks',JSON.stringify(rows.slice(-5000)))});
</script>