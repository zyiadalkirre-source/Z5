---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {products} from '../../data/products'; export function getStaticPaths(){return products.map(product=>({params:{id:product.id},props:{product}}));} const {product}=Astro.props; const base=import.meta.env.BASE_URL;
---
<BaseLayout title={product.name+' — Z5'} description={product.description}><section class="detail"><div class="detail-image"><img src={product.image} alt={product.name}></div><div><div class="eyebrow">{product.category} · {product.audience}</div><h1>{product.name}</h1><div>{product.rating ? '★ '+product.rating+' · '+product.reviews+' reviews' : 'Rating pending verification'}</div><p class="desc">{product.description}</p><div class="price big">{product.price ? '$ '+product.price : 'Price pending verification'} <span class="muted small">· {product.size}</span></div><ul class="feature-list">{product.features.map(f=><li>{f}</li>)}</ul><div class="offer"><div><b>{product.merchant}</b><div class="muted">Merchant: {product.availability}. Current price is not published until verified.</div></div><a class="btn" href={product.merchantUrl} target="_blank" rel="noopener noreferrer" data-shop data-product={product.id}>Visit merchant ↗</a></div><div class="detail-actions"><button class="btn light" data-wish={product.id}>♡ Wishlist</button><button class="btn light" data-compare={product.id}>＋ Compare</button></div><div class="notice" style="margin-top:16px">Affiliate status: <b>{product.affiliateStatus}</b>. Z5 never invents affiliate parameters; verified tracking links are enabled only after a valid program relationship is connected.</div></div></section></BaseLayout><script is:inline>const id='${product.id}';const key=k=>JSON.parse(localStorage.getItem(k)||'[]');document.querySelector('[data-wish]')?.addEventListener('click',()=>{const a=key('z5-wishlist');if(!a.includes(id))a.push(id);else a.splice(a.indexOf(id),1);localStorage.setItem('z5-wishlist',JSON.stringify(a));location.reload()});document.querySelector('[data-compare]')?.addEventListener('click',()=>{const a=key('z5-compare');if(!a.includes(id)&&a.length<4)a.push(id);localStorage.setItem('z5-compare',JSON.stringify(a));location.href='${base}compare'});document.querySelector('[data-shop]')?.addEventListener('click',()=>{const rows=key('z5-clicks');rows.push({product:id,timestamp:new Date().toISOString(),source:location.pathname,merchant:'${product.merchant}',url:'${product.merchantUrl}'});localStorage.setItem('z5-clicks',JSON.stringify(rows));});</script>