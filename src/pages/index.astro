---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products,categories} from '../data/products'; const featured=products.slice(0,3); const trending=products.slice(3);
---
<BaseLayout><section class="hero"><div><div class="eyebrow">Z5 Global Beauty Marketplace</div><h1>Find what fits your routine.</h1><p>Discover skincare, hair care, fragrance, grooming and more — compare products and follow the merchant offer.</p><div class="buttons"><a class="btn" href="/search">Explore products</a><a class="btn light" href="/compare">Compare picks</a></div></div><div class="hero-art"><img src="https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?auto=format&fit=crop&w=1000&q=85" alt="Beauty products"><div class="hero-note"><b>Discovery first.</b><span>Research products before you shop. Z5 does not process payments.</span></div></div></section><section class="section"><div class="head"><div><div class="eyebrow">Browse</div><h2>Shop by category</h2></div></div><div class="chips">{categories.map(c=><a class="chip" href={'/search?category='+encodeURIComponent(c)}>{c}</a>)}</div></section><section class="section"><div class="head"><div><div class="eyebrow">Editor’s selection</div><h2>Featured picks</h2></div><a href="/search">View all →</a></div><div class="grid">{featured.map(p=><a class="card" href={'/product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name}></div><div class="card-info"><div class="brand">{p.brand}</div><h3>{p.name}</h3><div class="meta"><span>★ {p.rating} · {p.reviews}</span><span class="price">$ {p.price}</span></div></div></a>)}</div></section><section class="section"><div class="head"><div><div class="eyebrow">Trending now</div><h2>Worth a closer look</h2></div></div><div class="grid">{trending.map(p=><a class="card" href={'/product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name}></div><div class="card-info"><div class="brand">{p.brand}</div><h3>{p.name}</h3><div class="meta"><span>★ {p.rating}</span><span class="price">$ {p.price}</span></div></div></a>)}</div></section><div class="trust"><div><b>Transparent by design.</b><p>Some outbound links may be affiliate links.</p></div><a class="btn light" href="/disclosure">Read disclosure</a></div></BaseLayout>