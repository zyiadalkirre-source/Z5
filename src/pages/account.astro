---
import BaseLayout from '../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Account — Z5">
  <section class="page">
    <div class="eyebrow">Your Z5</div>
    <h1>Account & preferences.</h1>
    <p class="muted">This static MVP keeps saved state in this browser. Production member auth can plug into the existing Wix Headless adapter.</p>
    <div class="account-grid">
      <div class="notice"><b>Saved items</b><strong id="wcount">0</strong><span class="small muted">Wishlist</span></div>
      <div class="notice"><b>Compare items</b><strong id="ccount">0</strong><span class="small muted">Current shortlist</span></div>
      <div class="notice"><b>Outbound clicks</b><strong id="clickcount">0</strong><span class="small muted">Browser analytics</span></div>
    </div>
    <div class="detail-actions">
      <a class="btn" href={base+'wishlist'}>Open wishlist</a>
      <a class="btn light" href={base+'recent'}>Recently viewed</a>
      <a class="btn light" href={base+'metrics'}>Analytics</a>
    </div>
    <div class="notice" style="margin-top:20px">
      <b>Production auth</b>
      <p>Wix Headless integration is prepared for member authentication and persistent member data. Keep API secrets server-side.</p>
    </div>
  </section>
</BaseLayout>
<script is:inline>
const count=k=>{try{return JSON.parse(localStorage.getItem(k)||'[]').length}catch{return 0}};
document.querySelector('#wcount').textContent=count('z5-wishlist');
document.querySelector('#ccount').textContent=count('z5-compare');
document.querySelector('#clickcount').textContent=count('z5-clicks');
</script>