---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products} from '../data/products';
---
<BaseLayout title="Recently Viewed — Z5"><section class="section"><div class="eyebrow">Your activity</div><h1>Recently viewed.</h1><p class="muted">Stored locally in this browser until account sync is connected.</p><div id="recent" class="grid"></div><script type="application/json" id="catalog">{JSON.stringify(products)}</script></section></BaseLayout><script is:inline>const all=JSON.parse(document.querySelector('#catalog').textContent);const ids=JSON.parse(localStorage.getItem('z5-recent')||'[]');const b=location.pathname.split('/recent')[0]+'/';const ps=ids.map(id=>all.find(p=>p.id===id)).filter(Boolean);document.querySelector('#recent').innerHTML=ps.length?ps.map(p=>'<a class="card" href="'+b+'product/'+p.id+'"><div class="card-img"><img src="'+p.image+'" alt=""></div><div class="card-info"><div class="brand">'+p.brand+'</div><h3>'+p.name+'</h3><div class="meta"><span>'+p.category+'</span><span class="price">'+(p.price?'$ '+p.price:'Pending')+'</span></div></div></a>').join(''):'<div class="notice">Nothing viewed yet. Start exploring the catalog.</div>';</script>