---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, categories } from '../data/products';
const base=import.meta.env.BASE_URL;
const category=Astro.url.searchParams.get('category')||'';
const audience=Astro.url.searchParams.get('audience')||'';
const budget=Number(Astro.url.searchParams.get('budget')||0);
const matched=products.filter(p=>(!category||p.category===category)&&(!audience||p.audience===audience)&&(!budget||p.price===null||p.price<=budget)).slice(0,6);
---
<BaseLayout title="Z5 Match — Beauty Discovery">
  <section class="catalog">
    <div class="eyebrow">Z5 Match</div>
    <h1>Find products that fit your criteria.</h1>
    <p class="muted">A transparent rules-based shortlist using the data Z5 currently has. No medical or outcome claims.</p>
  </section>
  <form class="filters search-panel" method="get">
    <div class="filter-grid">
      <select name="category"><option value="">Any category</option>{categories.map(c=><option value={c} selected={category===c}>{c}</option>)}</select>
      <select name="audience"><option value="">Any audience</option>{['Women','Men','Unisex'].map(a=><option value={a} selected={audience===a}>{a}</option>)}</select>
      <select name="budget"><option value="0">Any budget</option><option value="25" selected={budget===25}>Up to $25</option><option value="50" selected={budget===50}>Up to $50</option><option value="100" selected={budget===100}>Up to $100</option></select>
      <button class="btn" type="submit">Match me</button>
    </div>
  </form>
  <section class="section">
    <div class="head"><div><div class="eyebrow">Shortlist</div><h2>{matched.length} matches</h2></div><a class="head-link" href={base+'search'}>Browse full catalog →</a></div>
    {matched.length ? <div class="grid">{matched.map(p=><a class="card card-polished" href={base+'product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name} loading="lazy"><span class="card-pill">{p.audience}</span></div><div class="card-info"><div class="brand">{p.brand} · {p.category}</div><h3>{p.name}</h3><p class="muted">{p.features.slice(0,2).join(' · ')}</p></div></a>)}</div> : <div class="notice"><b>No matches on those constraints.</b><p>Relax one filter and try again.</p></div>}
  </section>
</BaseLayout>