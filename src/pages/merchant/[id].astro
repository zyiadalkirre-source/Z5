---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {products} from '../../data/products'; import {merchants} from '../../data/merchants'; export function getStaticPaths(){return merchants.map(m=>({params:{id:m.id},props:{merchant:m}}));} const {merchant}=Astro.props; const matched=products.filter(p=>p.merchant.toLowerCase().replace(/[^a-z]/g,'')===merchant.id.replace(/[^a-z]/g,'')||((merchant.id==='amazon'&&p.merchant==='Amazon')||(merchant.id==='neiman-marcus'&&p.merchant==='Neiman Marcus'))); const base=import.meta.env.BASE_URL;
---
<BaseLayout title={merchant.name+' — Z5'}><section class="catalog"><div class="eyebrow">Merchant</div><h1>{merchant.name}</h1><p class="muted">{merchant.network} · {merchant.markets.join(', ')}</p><div class="notice">Affiliate status: <b>{merchant.status}</b>. {merchant.notes}</div></section><section class="section"><div class="head"><h2>{matched.length} indexed products</h2><a class="btn light" href={merchant.website} target="_blank" rel="noopener noreferrer">Official website ↗</a></div><div class="grid">{matched.map(p=><a class="card" href={base+'product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name}></div><div class="card-info"><div class="brand">{p.brand}</div><h3>{p.name}</h3></div></a>)}</div></section></BaseLayout>