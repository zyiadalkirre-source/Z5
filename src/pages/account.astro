---
import BaseLayout from '../layouts/BaseLayout.astro'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Account — Z5"><section class="page"><div class="eyebrow">Your Z5</div><h1>Account & preferences.</h1><p class="muted">The static MVP keeps saved items in this browser. Production member auth and persistence can be connected to Wix Headless.</p><div class="account-grid"><div class="notice"><b>Saved items</b><strong id="wcount">0</strong></div><div class="notice"><b>Compare items</b><strong id="ccount">0</strong></div><div class="notice"><b>Outbound clicks</b><strong id="clickcount">0</strong></div></div><div class="buttons"><a class="btn" href={base+'wishlist'}>Wishlist</a><a class="btn light" href={base+'recent'}>Recently viewed</a><a class="btn light" href={base+'metrics'}>Analytics</a></div><div class="notice" style="margin-top:20px"><b>Production authentication</b><p>Wix Headless supports member authentication and persistent member access. Keep client IDs public as designed and keep admin/API-key secrets server-side.</p></div></section></BaseLayout><script is:inline>const n=k=>JSON.parse(localStorage.getItem(k)||'[]').length;document.querySelector('#wcount').textContent=n('z5-wishlist');document.querySelector('#ccount').textContent=n('z5-compare');document.querySelector('#clickcount').textContent=n('z5-clicks');</script>