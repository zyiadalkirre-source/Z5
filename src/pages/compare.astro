---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products} from '../data/products';
---
<BaseLayout title="Compare — Z5"><section class="page"><div class="eyebrow">Side by side</div><h1>Compare your shortlist.</h1><p class="muted">Up to four products, stored locally in this browser.</p><div id="compare"></div></section><script type="application/json" id="catalog">{JSON.stringify(products)}</script></BaseLayout><script is:inline>const all=JSON.parse(document.querySelector('#catalog').textContent);const b=location.pathname.split('/compare')[0]+'/';const ids=JSON.parse(localStorage.getItem('z5-compare')||'[]');const ps=ids.map(id=>all.find(p=>p.id===id)).filter(Boolean);const root=document.querySelector('#compare');if(!ps.length){root.innerHTML='<div class="notice">Your comparison is empty.</div><a class="btn" href="'+b+'search">Browse products</a>'}else{root.innerHTML='<div class="compare-table">'+ps.map(p=>'<article class="compare-card"><img src="'+p.image+'" alt=""><b>'+p.brand+'</b><h3>'+p.name+'</h3><p>Category: '+p.category+'</p><p>Audience: '+p.audience+'</p><p>Price: '+(p.price?'$'+p.price:'Pending')+'</p><p>Rating: '+(p.rating||'Pending')+'</p><p>Merchant: '+p.merchant+'</p><a class="btn" href="'+b+'product/'+p.id+'">View</a></article>').join('')+'</div><button class="btn light" id="clear">Clear comparison</button>';document.querySelector('#clear').onclick=()=>{localStorage.removeItem('z5-compare');location.reload()}}</script>