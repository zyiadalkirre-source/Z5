---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products,categories} from '../data/products'; const q=(Astro.url.searchParams.get('q')||'').toLowerCase(); const category=Astro.url.searchParams.get('category')||''; const audience=Astro.url.searchParams.get('audience')||''; const filtered=products.filter(p=>(!q||[p.name,p.brand,p.category].join(' ').toLowerCase().includes(q))&&(!category||p.category===category)&&(!audience||p.audience===audience));
---
<BaseLayout title="Shop — Z5"><section class="catalog"><div class="eyebrow">Z5 catalog</div><h1>Discover beauty products.</h1><p class="muted">Search by product, brand or category.</p></section><form class="filters" method="get"><input name="q" value={q} placeholder="Search products..."><select name="category"><option value="">All categories</option>{categories.map(c=><option value={c} selected={category===c}>{c}</option>)}</select><select name="audience"><option value="">All audiences</option><option value="Women" selected={audience==='Women'}>Women</option><option value="Men" selected={audience==='Men'}>Men</option><option value="Unisex" selected={audience==='Unisex'}>Unisex</option></select><button class="btn" type="submit">Apply</button></form><section class="section"><div class="head"><h2>{filtered.length} products</h2></div><div class="grid">{filtered.map(p=><a class="card" href={'/product/'+p.id}><div class="card-img"><img src={p.image} alt={p.name}></div><div class="card-info"><div class="brand">{p.brand} · {p.category}</div><h3>{p.name}</h3><div class="meta"><span>★ {p.rating} · {p.reviews}</span><span class="price">$ {p.price}</span></div></div></a>)}</div></section></BaseLayout>