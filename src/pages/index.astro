---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products,categories} from '../data/products'; const featured=products.slice(0,3); const trending=products.slice(3);
---
<BaseLayout><section class="hero"><div><div class="eyebrow">Z5 Global Beauty Marketplace</div><h1>Find what fits your routine.</h1><p>Discover skincare, hair care, fragrance, grooming and more — compare products and follow the best merchant offer.</p><div style="display:flex;gap:10px;margin-top:26px"><a class="btn" href="/search">Explore products</a><a class="btn light" href="/compare">Compare picks</a></div></div><div class="hero-card"><img src="https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?auto=format&fit=crop&w=1000&q=85" alt="Beauty products arranged together"><div class="hero-note"><strong>Discovery first.</strong><span class="muted">Z5 helps you research before you shop. We don't process payments.</span></div></div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Browse</div><h2>Shop by category</h2></div></div><div class="chips">{categories.map(c=><a class="chip" href={'/search?category='+encodeURIComponent(c)}>{c}</a>)}</div></section>
<section class="section" style="padding-top:10px"><div class="section-head"><div><div class="eyebrow">Editor’s selection</div><h2>Featured picks</h2></div><a href="/search" class="muted">View all →</a></div><div class="grid">{featured.map(p=><a class="product-card" href={'/product/'+p.id}><div class="product-img"><img src={p.image} alt={p.name} loading="lazy"></div><div class="product-info"><div class="brand">{p.brand}</div><h3>{p.name}</h3><div class="meta"><span class="rating">★ {p.rating} · {p.reviews} reviews</span><span class="price">$ {p.price}</span></div></div></a>)}</div></section>
<section class="section" style="padding-top:20px"><div class="section-head"><div><div class="eyebrow">Trending now</div><h2>Worth a closer look</h2></div></div><div class="grid">{trending.map(p=><a class="product-card" href={'/product/'+p.id}><div class="product-img"><img src={p.image} alt={p.name} loading="lazy"></div><div class="product-info"><div class="brand">{p.brand}</div><h3>{p.name}</h3><div class="meta"><span class="rating">★ {p.rating}</span><span class="price">$ {p.price}</span></div></div></a>)}</div></section><div class="trust"><div><strong>Transparent by design.</strong><p>Some links may be affiliate links. We clearly disclose that relationship.</p></div><a class="btn light" href="/disclosure">Read disclosure</a></div></BaseLayout>