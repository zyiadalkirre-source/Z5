---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products} from '../data/products';
---
<BaseLayout title="Admin — Z5"><section class="section"><div class="eyebrow">Operations</div><h1>Catalog admin</h1><p class="muted">Catalog health and affiliate readiness. Static MVP is intentionally read-only.</p><div class="admin-stats"><div class="notice"><b>Products</b><strong>{products.length}</strong></div><div class="notice"><b>Affiliate verified</b><strong>{products.filter(p=>p.affiliateStatus==='verified').length}</strong></div><div class="notice"><b>Price verified</b><strong>{products.filter(p=>p.verifiedPrice).length}</strong></div></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Merchant</th><th>Price</th><th>Affiliate</th><th>Status</th></tr></thead><tbody>{products.map(p=><tr><td>{p.brand} — {p.name}</td><td>{p.merchant}</td><td>{p.price ?? 'Pending'}</td><td>{p.affiliateStatus}</td><td>{p.availability}</td></tr>)}</tbody></table></div></section></BaseLayout>