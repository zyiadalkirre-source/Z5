---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products} from '../data/products'; import {merchants} from '../data/merchants';
---
<BaseLayout title="Admin — Z5"><section class="section"><div class="eyebrow">Operations</div><h1>Catalog admin</h1><p class="muted">Operational snapshot. Publishing, affiliate activation and credentialed writes should move to a protected backend/Wix dashboard before production.</p><div class="admin-stats"><div class="notice"><b>Products</b><strong>{products.length}</strong></div><div class="notice"><b>Merchants</b><strong>{merchants.length}</strong></div><div class="notice"><b>Affiliate verified</b><strong>{products.filter(p=>p.affiliateStatus==='verified').length}</strong></div></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Merchant</th><th>Price</th><th>Affiliate</th><th>Availability</th></tr></thead><tbody>{products.map(p=><tr><td>{p.brand} — {p.name}</td><td>{p.merchant}</td><td>{p.price ?? 'Pending'}</td><td>{p.affiliateStatus}</td><td>{p.availability}</td></tr>)}</tbody></table></div><h2>Affiliate program readiness</h2><div class="grid">{merchants.map(m=><article class="card"><div class="card-info"><div class="brand">{m.network}</div><h3>{m.name}</h3><p class="muted">{m.affiliateProgram}</p><div class="meta"><span>{m.status}</span><span>{m.markets.join(' · ')}</span></div></div></article>)}</div></section></BaseLayout>