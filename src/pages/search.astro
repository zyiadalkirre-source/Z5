---
import BaseLayout from '../layouts/BaseLayout.astro'; import {products,categories} from '../data/products';
const q=(Astro.url.searchParams.get('q')||'').toLowerCase(),category=Astro.url.searchParams.get('category')||'',audience=Astro.url.searchParams.get('audience')||'';
const filtered=products.filter(p=>(!q||[p.name,p.brand,p.category].join(' ').toLowerCase().includes(q))&&(!category||p.category===category)&&(!audience||p.audience===audience));
---
<BaseLayout title="Shop — Z5"><section class="catalog-head"><div class="eyebrow">Z5 catalog</div><h1>Discover beauty products.</h1><p class="muted">Search by product, brand or category. Use filters to narrow the catalog.</p></section><form class="filters" method="get"><input name="q" value={q} placeholder="Search products..." style="flex:1;min-width:220px;padding:13px 16px;border:1px solid var(--line);border-radius:999px"><select name="category" style="padding:13px 16px;border:1px solid var(--line);border-radius:999px"><option value="">All categories</option>{categories.map(c=><option value={c} selected={category===c}>{c}</option>)}</select><select name="audience" style="padding:13px 16px;border:1px solid var(--line);border-radius:999px"><option value="">All audiences</option><option value="Women" selected={audience==='Women'}>Women</option><option value="Men" selected={audience==='Men'}>Men</option><option value="Unisex" selected={audience==='Unisex'}>Unisex</option></select><button class="btn" type="submit">Apply</button></form><section class="section" style="padding-top:10px"><div class="section-head"><h2>{filtered.length} products</h2></div>{filtered.length?<div class="grid">{filtered.map(p=><a class="product-card" href={'/product/'+p.id}><div class="product-img"><img src={p.image} alt={p.name} loading="lazy"></div><div class="product-info"><div class="brand">{p.brand} · {p.category}</div><h3>{p.name}</h3><div class="meta"><span class="rating">★ {p.rating} · {p.reviews}</span><span class="price">$ {p.price}</span></div></div></a>)}</div>:<div class="notice">No matching products yet. Try another search or category.</div>}</section></BaseLayout>