---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {products} from '../../data/products'; export function getStaticPaths(){return products.map(p=>({params:{id:p.id},props:{product:p}}));} const {product}=Astro.props;
---
<BaseLayout title={product.name+' — Z5'} description={product.description}><section class="product-page"><a class="muted" href="/search">← Back to products</a><div class="product-detail" style="margin-top:28px"><div class="main-image"><img src={product.image} alt={product.name}></div><div><div class="eyebrow">{product.category} · {product.audience}</div><h1>{product.name}</h1><div class="rating">★ {product.rating} · {product.reviews} reviews</div><p class="desc">{product.description}</p><div class="price" style="font-size:26px">$ {product.price} <span class="muted" style="font-size:13px;font-weight:400">· {product.size}</span></div><ul class="feature-list">{product.features.map(f=><li>✓ {f}</li>)}</ul><div class="offer"><div><strong>{product.merchant}</strong><div class="muted" style="font-size:12px;margin-top:4px">Merchant availability and price may change.</div></div><a class="btn" href={product.merchantUrl} data-shop data-product={product.id}>Shop Now ↗</a></div><div class="notice" style="margin-top:16px">Affiliate transparency: Z5 may earn a commission when you use an eligible outbound shopping link. Z5 does not process payments or orders.</div></div></div></section></BaseLayout><script is:inline>document.querySelectorAll('[data-shop]').forEach(a=>a.addEventListener('click',()=>{const k='z5-clicks';const rows=JSON.parse(localStorage.getItem(k)||'[]');rows.push({product:a.dataset.product,timestamp:new Date().toISOString(),source:location.pathname});localStorage.setItem(k,JSON.stringify(rows));}));</script>